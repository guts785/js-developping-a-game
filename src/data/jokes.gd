static func pick(bank: String, seed_value: int = -1) -> String:
	var b: Dictionary = banks()
	if not b.has(bank) or (b[bank] as Array).is_empty():
		return ""
	var arr: Array = b[bank]
	if seed_value < 0:
		return str(arr[randi() % arr.size()])
	return str(arr[seed_value % arr.size()])
